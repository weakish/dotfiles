#!/bin/sh

set -e

find_python() {
	for candidate in python3 python; do
		if command -v "$candidate" >/dev/null 2>&1 &&
			"$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' 2>/dev/null; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

as_root() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	else
		sudo "$@"
	fi
}

apt_get() {
	as_root env DEBIAN_FRONTEND=noninteractive apt-get "$@"
}

apt_install() {
	# --no-install-recommends: keep a minimal dev VM minimal.
	apt_get install --yes --no-install-recommends "$@"
}

install_doit() {
	if command -v apt-get >/dev/null 2>&1; then
		# system Python is externally managed on Debian/Ubuntu (PEP 668)
		apt_install python3-doit
		python=$(find_python) || {
			echo "apt installed python3-doit, but no Python >= 3.10 was found." >&2
			exit 1
		}
	elif [ -n "$python" ]; then
		"$python" -m pip install doit
	elif command -v port >/dev/null 2>&1; then
		as_root port -N install python313 py313-pip
		as_root port select --set python python313
		as_root port select --set python3 python313
		python=/opt/local/bin/python3.13
		"$python" -m pip install doit
	elif command -v brew >/dev/null 2>&1; then
		brew install python
		python=$(find_python) || {
			echo "Please install Python (>= 3.10) then run script/setup again." >&2
			exit 1
		}
		"$python" -m pip install doit
	else
		echo "Please install Python (>= 3.10) then run script/setup again." >&2
		exit 1
	fi
}

# mise is not in Debian; extrepo enables its signed apt repository from Debian's
# catalog. `extrepo enable` needs root but does not prompt.
install_mise() {
	if command -v mise >/dev/null 2>&1; then
		return 0
	fi
	as_root extrepo enable mise
	apt_get update
	apt_install mise
	if ! command -v mise >/dev/null 2>&1; then
		echo "mise was installed, but mise is not on PATH." >&2
		exit 1
	fi
}

# Pi needs Node 22.19+; mise installs the newest 22.x into its own data directory,
# so the system Node is left alone.
install_node22() {
	mise install node@22
}

# Pi runs on mise's Node 22; the installer drops a shim in ~/.local/bin.
pi_search_path() {
	node22_dir=$(mise where node@22) || exit 1
	printf '%s/bin:%s\n' "$node22_dir" "$HOME/.local/bin"
}

install_pi() {
	pi_path="$(pi_search_path):$PATH"
	if PATH="$pi_path" command -v pi >/dev/null 2>&1; then
		return 0
	fi
	mkdir -p "$HOME/.local/bin"
	installer=$(mktemp)
	curl -fsSL https://pi.dev/install.sh -o "$installer"
	# Pi's installer prompts on /dev/tty; detach so setup stays non-interactive.
	PATH="$pi_path" setsid -w sh "$installer"
	rm -f "$installer"
	if ! PATH="$pi_path" command -v pi >/dev/null 2>&1; then
		echo "Pi was installed, but pi is not on PATH." >&2
		exit 1
	fi
}

# Web search and page fetching, keyless by default; keys go in
# ~/.pi/agent/web-search.json. pi install is idempotent and needs no TTY.
install_pi_packages() {
	pi_path="$(pi_search_path):$PATH"
	PATH="$pi_path" pi install npm:pi-web-access </dev/null
}

# Codex CLI ships on npm only for Linux; npm from the Pi Node runtime installs
# it under ~/.local so no sudo is needed.
install_codex() {
	codex_path="$HOME/.local/bin:$(pi_search_path):$PATH"
	if PATH="$codex_path" command -v codex >/dev/null 2>&1; then
		return 0
	fi
	PATH="$(pi_search_path):$PATH" npm install --global --prefix "$HOME/.local" @openai/codex
	if ! PATH="$codex_path" command -v codex >/dev/null 2>&1; then
		echo "Codex was installed, but codex is not on PATH." >&2
		exit 1
	fi
}

# The installer is bash-only. --non-interactive skips `hermes setup` and the
# gateway service, which would otherwise read /dev/tty; the browser and
# computer-use drivers are not needed on a headless VM.
install_hermes() {
	hermes_path="$HOME/.local/bin:$PATH"
	if PATH="$hermes_path" command -v hermes >/dev/null 2>&1; then
		return 0
	fi
	installer=$(mktemp)
	curl -fsSL https://hermes-agent.nousresearch.com/install.sh -o "$installer"
	setsid -w bash "$installer" --non-interactive --skip-browser --skip-computer-use
	rm -f "$installer"
	if ! PATH="$hermes_path" command -v hermes >/dev/null 2>&1; then
		echo "Hermes was installed, but hermes is not on PATH." >&2
		exit 1
	fi
}

# Native installer (npm is deprecated). Bash-only; setsid keeps it off /dev/tty.
# Binary lands in ~/.local/bin; run `claude` later to sign in.
install_claude() {
	claude_path="$HOME/.local/bin:$PATH"
	if PATH="$claude_path" command -v claude >/dev/null 2>&1; then
		return 0
	fi
	mkdir -p "$HOME/.local/bin"
	installer=$(mktemp)
	curl -fsSL https://claude.ai/install.sh -o "$installer"
	setsid -w bash "$installer"
	rm -f "$installer"
	if ! PATH="$claude_path" command -v claude >/dev/null 2>&1; then
		echo "Claude Code was installed, but claude is not on PATH." >&2
		exit 1
	fi
}

setup_macos() {
	if command -v port >/dev/null 2>&1; then
		# -N: non-interactive; ports needing a license/variant answer may fail
		# instead of prompting, and set -e will abort the whole setup run.
		as_root port -N selfupdate
		as_root port -N upgrade outdated
		as_root port -N install claude-code codex mise
		port installed requested and active >ports.txt
	fi
	if command -v brew >/dev/null 2>&1; then
		# copy .zshrc first because PATH is set in .zshrc
		cp .zshrc ~/.zshrc
		brew analytics off
		export HOMEBREW_CASK_OPTS="--require-sha"
		brew update
		brew bundle install
		# --yes: skip "proceed with the upgrade?" (Homebrew ask mode default)
		brew upgrade --greedy --yes
	fi
	if command -v mas >/dev/null 2>&1; then
		# skip mas upgrade since mas requires macOS 15+ and this mac is still on macOS 14
		# mas upgrade
		mas list >mas.txt
	fi
	if [ -e /Applications/Setapp ]; then
		: >setapp.txt
		for f in /Applications/Setapp/*.app; do
			[ -e "$f" ] || continue
			printf '%s\n' "${f##*/}" >>setapp.txt
		done
		LC_ALL=C sort -o setapp.txt setapp.txt
	fi
}

setup_linux() {
	if ! command -v apt-get >/dev/null 2>&1; then
		echo "Unsupported Linux distribution: no apt-get (need Debian or Ubuntu)." >&2
		exit 1
	fi
	apt_get update
	set --
	while IFS= read -r package || [ -n "$package" ]; do
		case "$package" in
			'' | '#'*) continue ;;
		esac
		set -- "$@" "$package"
	done <linux-packages.txt
	apt_install "$@"
	install_mise
	install_node22
	install_pi
	install_pi_packages
	install_codex
	install_hermes
	install_claude
}

main() {
	cp -n myconfig.example.py myconfig.py || echo "myconfig.py existed, will use it"
	case "$(uname -s)" in
		Darwin) setup_macos ;;
		Linux) setup_linux ;;
		*)
			echo "Unsupported operating system: $(uname -s)" >&2
			exit 1
			;;
	esac
	if ! python=$(find_python); then
		install_doit
	fi
	if ! "$python" has-doit.py; then
		install_doit
	fi
	"$python" -m doit
}

main
