#!/bin/sh

set -e

if [ ! -f pyproject.toml ] || [ ! -f script/check ]; then
	echo "check: run from the dotfiles repo root" >&2
	echo "  current: $(pwd)" >&2
	exit 1
fi

if [ ! -e myconfig.py ]; then
	cp myconfig.example.py myconfig.py
fi

print_shell_lint_install_hint() {
	if command -v port >/dev/null 2>&1; then
		echo "  sudo port install shellcheck shfmt" >&2
	elif command -v brew >/dev/null 2>&1; then
		echo "  brew install shellcheck shfmt" >&2
	else
		echo "  sudo port install shellcheck shfmt" >&2
		echo "  or: brew install shellcheck shfmt" >&2
	fi
}

require_cmd() {
	if ! command -v "$1" >/dev/null 2>&1; then
		echo "check: missing $1" >&2
		case "$1" in
			ruff | ty | shuck)
				echo "  pip install -r requirements-dev.txt" >&2
				;;
			shellcheck | shfmt)
				print_shell_lint_install_hint
				;;
		esac
		exit 1
	fi
}

require_cmd ruff
require_cmd ty
require_cmd shuck
require_cmd shellcheck
require_cmd shfmt

run_step() {
	echo "check: $*"
	"$@"
}

run_step ruff check .
run_step ruff format --check .
run_step ty check
run_step shellcheck -s sh script/setup script/check
run_step shellcheck -s dash script/setup script/check
run_step shuck check script/setup script/check .github/workflows/check.yml
run_step shfmt -d -i 0 -ci script/setup script/check
